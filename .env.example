# ---- Server ----
# Shared secret that TradingView must include in every webhook payload.
# Generate a long random string. Alerts without this exact value are rejected.
WEBHOOK_SECRET=change-me-to-a-long-random-string

# ---- Execution mode ----
# "confirm" = bot asks you on Telegram with Buy/Cancel buttons before trading
# "auto"    = bot places the trade immediately, then notifies you
# Can be overridden per-alert with a "mode" field in the TradingView payload.
EXECUTION_MODE=confirm

# ---- Autonomous strategy ----
# Used when a TradingView signal arrives WITHOUT qty/notional: the bot sizes it.
# Dollars to deploy per new position (buys floor(size / price) whole shares).
POSITION_SIZE_USD=1000
# Never hold more than this many positions at once.
MAX_POSITIONS=5
# S2O / B2C are short-side signals; requires a MARGIN account. Keep false on cash.
ALLOW_SHORTING=false

# ---- Webull OpenAPI ----
# Apply for API access + generate App Key/Secret:
#   US: https://www.webull.com/center#openApiManagement
# See other regions in the README.
WEBULL_APP_KEY=your-webull-app-key
WEBULL_APP_SECRET=your-webull-app-secret
# Your region: us, hk, jp, sg, th, au, my, uk, br, mx, za, eu
WEBULL_REGION_ID=us
# Leave blank to auto-pick your first account. Or set it explicitly.
WEBULL_ACCOUNT_ID=
# true  = sandbox / paper trading (fake money, recommended)
# false = LIVE trading (real money)
WEBULL_PAPER=true

# ---- Telegram ----
# Create a bot with @BotFather -> get the token.
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
# Your chat id. Message @userinfobot to get it. Only this chat can confirm trades.
TELEGRAM_CHAT_ID=123456789
